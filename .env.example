# App Settings
APP_NAME="Aphri"
APP_VERSION="1.0.0"
DEBUG=True
SECRET_KEY=your-super-secret-key-change-this-in-production
BASE_URL=http://localhost:8000

# Database
DATABASE_URL=sqlite:///./data/aphri.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://aphri_user:password@localhost:5432/aphri_db

# Chapa Payment
CHAPA_SECRET_KEY=your_chapa_secret_key
CHAPA_WEBHOOK_SECRET=your_webhook_secret

# AWS S3 (for photo storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=aphri-photos

# Push Notifications
FCM_SERVER_KEY=your-fcm-server-key

# CORS
ALLOWED_ORIGINS=http://localhost:19000,http://localhost:19006,https://aphri.com

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60